# Signing material and credentials. Never commit these.
*.jks
*.keystore
key.properties
*.pem
*.p12
*.pfx
*.jwk
.env
.env.*
!.env.example
*.env
!*.env.example
secrets/
*.secret
*.secrets

# Supabase local runtime state (contains local runtime secrets)
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*
supabase/functions/.env
supabase/functions/**/.env

# Local databases and benchmark/scratch artifacts
*.sqlite
*.sqlite-*
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
scratch/
tmp/
*.tmp
